# Copy the server block into your Nginx site configuration and adjust PHP-FPM socket.
# The document root must point to this project directory.
server {
    listen 80;
    server_name example.test;
    root /home/linuxbrew/.linuxbrew/var/www/php84/php-mvc-codekop;
    index index.php;

    client_max_body_size 10m;
    charset utf-8;

    # Only the front controller may be passed to PHP-FPM.
    location = /index.php {
        try_files $uri =404;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param HTTP_PROXY "";
        fastcgi_pass 127.0.0.1:9000;
    }

    # Source, dependency, session, and queue directories are never public.
    # The ^~ prefix prevents a later regex location from handling them.
    location = /app { return 404; }
    location ^~ /app/ { return 404; }
    location = /system { return 404; }
    location ^~ /system/ { return 404; }
    location = /storage { return 404; }
    location ^~ /storage/ { return 404; }
    location = /vendor { return 404; }
    location ^~ /vendor/ { return 404; }
    location = /tests { return 404; }
    location ^~ /tests/ { return 404; }

    location ~* ^/(?:\.git|\.github|\.codex|\.agents)(?:/|$) {
        return 404;
    }

    location ~* ^/(?:composer\.(?:json|lock)|README\.md|CHANGELOG\.md|AGENTS\.md|nginx\.conf\.example|apache2\.conf\.example)$ {
        return 404;
    }

    location ~* \.(?:env|log|sql|sqlite|sqlite3|ini|bak|old)$ {
        return 404;
    }

    # Any PHP URL other than the exact front controller is rejected.
    location ~* \.php(?:/|$) { return 404; }

    location ~ /\. {
        return 404;
    }

    location / {
        try_files $uri $uri/ /index.php?url=$uri&$query_string;
    }
}
