# Copy the server block into your Nginx site configuration and adjust PHP-FPM socket.
# The document root must point to this project directory.
server {
    listen 80;
    server_name example.test;
    root /home/linuxbrew/.linuxbrew/var/www/php84/php-mvc-codekop;
    index index.php;

    client_max_body_size 10m;
    charset utf-8;

    location / {
        try_files $uri $uri/ /index.php?url=$uri&$query_string;
    }

    location ^~ /assets/plugins/php-debugbar/dist/ {
        try_files $uri =404;
    }

    location ~ \.php$ {
        try_files $uri =404;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param HTTP_PROXY "";
        fastcgi_pass 127.0.0.1:9000;
    }

    location ~ ^/(?:app|system|storage|vendor)/ {
        deny all;
        return 404;
    }

    location ~ /\. {
        deny all;
        return 404;
    }
}
